## example input file (for ver. 2.1.0)
## generated by glafic -d

## setting primary parameters
omega     0.3089
lambda    0.6910
weos      -1.000000
hubble    0.6736
prefix    pow_pos+flux
xmin	  -1
ymin	  -0.4
xmax	  0.4
ymax	  1.0
pix_ext   0.001
pix_poi   0.001
maxlev	  1

## some examples of secondary parameters
chi2_splane    1
chi2_checknimg 1
chi2_restart   -1
chi2_usemag    0
hvary          0
ran_seed -122000

## define lenses and sources
startup 1 0 1
lens pow   1.1009  2.224500e+00 -2.718057e-01  4.137265e-01  1.485158e-01  2.828679e+00  4.561778e-01  1.718503e+00
point 2.2245 -2.694114e-01  3.610592e-01
end_startup

## for optimizations
## can be ignored unless you do opts
start_setopt
1 0 1 1 1 1 1 1 
0 1 1
end_setopt

## execute commands
start_command

readobs_point obs_pos+flux.dat
parprior prior.dat

mcmc_sigma sigfile_point.dat
mcmc 500000

quit